# ==========================================
# Full-Stack News Aggregator .gitignore
# ==========================================

# 1. Dependencies
# Ignore node_modules directory in root and all subdirectories (frontend & backend)
node_modules/
**/node_modules/

# 2. Production & Build Outputs
# Ignore compiled build files and distribution bundles
build/
dist/
**/build/
**/dist/

# 3. Test Coverage
# Ignore test coverage reports generated by testing frameworks (Jest, Mocha, etc.)
coverage/
*.lcov

# 4. Environment and Secret Files
# Ignore local environment files containing API keys, database credentials, and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# 5. Log Files
# Ignore package manager and application log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# 6. Operating System Files
# Ignore OS-generated metadata files
.DS_Store
Thumbs.db
Desktop.ini

# 7. IDE & Text Editor Configuration
# Ignore local IDE settings for Visual Studio Code and JetBrains IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 8. Package Manager Lockfiles Note
# package-lock.json is tracked by default for consistent builds across environments.
# If project policy requires ignoring lock files, uncomment the following line:
# package-lock.json
